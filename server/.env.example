# ===========================================
# SERVER CONFIGURATION
# ===========================================
PORT=5000

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# MongoDB connection string
# For local development with MongoDB installed:
MONGODB_URI=mongodb://127.0.0.1:27017/eyewear-platform

# For MongoDB Atlas (cloud database):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/eyewear-platform?retryWrites=true&w=majority

# ===========================================
# JWT AUTHENTICATION
# ===========================================
# Secret key for JWT token signing
# IMPORTANT: Use a strong random string in production
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# ===========================================
# FRONTEND URL (CORS)
# ===========================================
# URL of your frontend application (used for CORS)
FRONTEND_URL=http://localhost:3000

# ===========================================
# ADMIN EMAIL
# ===========================================
# Admin email for notifications and system alerts
ADMIN_EMAIL=admin@example.com

# ===========================================
# EMAIL CONFIGURATION (SMTP)
# ===========================================
# Used for sending OTP emails, order confirmations, etc.
# For Gmail: You need to generate an App Password
# Go to: https://myaccount.google.com/apppasswords
# Enable 2FA first, then generate App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here

# ===========================================
# RAZORPAY PAYMENT GATEWAY
# ===========================================
# Get these from: https://dashboard.razorpay.com/
# Go to Settings > API Keys > Generate Test/Live Keys
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# ===========================================
# SHIPROCKET SHIPPING API
# ===========================================
# Get these from: https://app.shiprocket.in/
# Login and go to Settings > API
SHIPROCKET_EMAIL=your_shiprocket_email@example.com
SHIPROCKET_PASSWORD=your_shiprocket_password_here
SHIPROCKET_API_KEY=your_shiprocket_api_key_here

# ===========================================
# CLOUDINARY (Image Storage)
# ===========================================
# Get these from: https://cloudinary.com/
# Used for product images, prescription uploads, etc.
# Go to Dashboard > Account Details > Cloudinary Settings
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# ===========================================
# NODE ENVIRONMENT
# ===========================================
NODE_ENV=development

# ===========================================
# AI CHATBOT CONFIGURATION
# ===========================================
# OpenAI API for intelligent chatbot responses
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo

# Chatbot knowledge base settings
CHATBOT_ENABLED=true
CHATBOT_MAX_TOKENS=500
CHATBOT_TEMPERATURE=0.7

# ===========================================
# FACE DETECTION & ANALYSIS API
# ===========================================
# AWS Rekognition for face shape detection
# Get credentials from: https://aws.amazon.com/rekognition/
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1

# Alternative: Google Cloud Vision API
# Get from: https://cloud.google.com/vision
GOOGLE_VISION_API_KEY=your_google_vision_api_key_here

# Alternative: Azure Face API
# Get from: https://azure.microsoft.com/en-us/products/ai-services/face-api/
AZURE_FACE_API_KEY=your_azure_face_api_key_here
AZURE_FACE_ENDPOINT=https://your-region.api.cognitive.microsoft.com/

# Face detection service preference: 'aws', 'google', or 'azure'
FACE_DETECTION_SERVICE=aws

# ===========================================
# SPEECH RECOGNITION (Audio Search)
# ===========================================
# Google Cloud Speech-to-Text API
# Get from: https://cloud.google.com/speech-to-text
GOOGLE_SPEECH_API_KEY=your_google_speech_api_key_here

# Alternative: AWS Transcribe
# Uses same AWS credentials as above
AWS_TRANSCRIBE_ENABLED=true

# Speech recognition service preference: 'google' or 'aws'
SPEECH_RECOGNITION_SERVICE=google

# ===========================================
# VIRTUAL TRY-ON AR SERVICE
# ===========================================
# Get from: https://www.banuba.com/ or https://deepar.co/
VIRTUAL_TRYON_API_KEY=your_virtual_tryon_api_key_here
VIRTUAL_TRYON_ENABLED=false

# ===========================================
# ANALYTICS & MONITORING
# ===========================================
# Sentry for error tracking
SENTRY_DSN=your_sentry_dsn_here

# Google Analytics
GOOGLE_ANALYTICS_ID=your_ga_id_here

# ===========================================
# DELIVERY PARTNER PAYOUTS (second Razorpay account)
# ===========================================
# Separate merchant account used only to pay delivery partners out of their
# withdrawals, so partner money never mixes with platform revenue.
RAZORPAY2_KEY_ID=your_razorpay2_key_id_here
RAZORPAY2_KEY_SECRET=your_razorpay2_key_secret_here

# ===========================================
# RAZORPAYX (automated seller settlements)
# ===========================================
# Without these, seller payouts stay `pending` with an `awaiting_settlement`
# reason instead of reporting a transfer that never happened.
RAZORPAYX_KEY_ID=your_razorpayx_key_id_here
RAZORPAYX_KEY_SECRET=your_razorpayx_key_secret_here

# ===========================================
# PROXY / SESSION BEHAVIOUR
# ===========================================
# How many reverse proxies sit in front of this server. Express `trust proxy`
# is deliberately never set to `true`, because that lets any client spoof the IP
# that the rate limiters and audit logs key on.
#   0 (or unset) - direct connections, local development
#   1            - one proxy (nginx, Heroku, Render, Railway)
TRUST_PROXY_HOPS=0

# Allow the seeded test accounts to skip the emailed login OTP. Applied only
# when NODE_ENV is not "production"; set to false to enforce OTP everywhere.
AUTH_OTP_BYPASS=true

# ===========================================
# WEB PUSH (browser push notifications)
# ===========================================
# Generate a VAPID key pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:admin@optikart.com


# INERT since the seed left the boot path: nothing seeds at startup in any
# environment, and the app cannot reach the dataset from server.js. The demo
# fixtures now only apply deliberately: npm run fixtures:apply (server/), which
# refuses unless the eleven collections it owns are empty (or --force, with a
# matching --expect-database). Setting SEED_ON_BOOT=true on a production-mode
# process without ALLOW_DEMO_SEED=true is a boot error - not because it would
# seed (it cannot) but because it means someone is running a stale runbook.
SEED_ON_BOOT=auto

# ---------------------------------------------------------------------------
# Going live (all read at boot; production refuses to start if these are wrong)
# ---------------------------------------------------------------------------
# The only administrator on a fresh install. Created when no active admin exists.
# Password: 12+ characters, nothing guessable. It is never logged, and it is the
# only credential this app will create for you - nothing here invents a default.
# Remove BOOTSTRAP_ADMIN_PASSWORD from the environment once you have signed in.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=

# In production these three are mandatory and checked before the port opens:
#   NODE_ENV=production requires SMTP_* (every sign-in second factor is emailed -
#   without mail nobody, including you, can ever log in again)
#   JWT_SECRET of 32+ characters that is not a placeholder
#   SEED_ON_BOOT=true (the boot path refuses it - see SEED_ON_BOOT in the
#   Going-live interlocks above; nothing seeds at startup in any mode).
# AUTH_OTP_BYPASS is documented once, under PROXY / SESSION BEHAVIOUR; there is
# deliberately no second copy here - a value stated twice is a value someone
# will change in only one of the two places.

# ===========================================
# FILE STORAGE BACKEND
# ===========================================
# Where user uploads (product images, prescription scans, logos) are written.
# The project rule is that uploads live in Cloudinary and nothing is kept on the
# app server's disk - that is a production guarantee, not a preference. A
# production instance that silently fell back to local disk would lose every
# image on the next redeploy AND serve attacker-influenced bytes from the same
# origin as the app, so the local fallback only exists for dev/CI and is refused
# in production unless you explicitly acknowledge it.
#   unset | "auto"   Cloudinary when credentials are present, else local (dev/CI)
#   "cloudinary"     required; missing Cloudinary credentials are a boot error
#   "local"          explicit override; refused in production unless the flag below is set
STORAGE_BACKEND=auto

# Set to true to permit STORAGE_BACKEND=local (or the auto->local fallback) in a
# production-mode process. Only mean this for an air-gapped installation with its
# own persistent volume; on any host that redeploys, uploads written here are lost
# on the next deploy. Also gates whether the app will serve /uploads/* at all.
ALLOW_LOCAL_STORED_UPLOADS=false

# ===========================================
# HTTP / REQUEST LIMITS
# ===========================================
# Max size of a JSON or urlencoded request body. Uploads do NOT go through this
# (they are multipart, capped per-file in middleware/upload.js), so this is sized
# for documents - a product, an order, a list of ids. The historical value was
# 50mb on every route, so one unauthenticated POST could book 50mb of parse work
# and several of those is an outage. Raise it only when a real integration needs
# more than a document.
JSON_BODY_LIMIT=1mb

# Comma-separated upstream DNS servers for this process to resolve through.
# Empty/unset is correct: DNS is left to the container/host (its own resolv.conf,
# private zones, /etc/hosts, VPC-internal MongoDB). A hardcoded 8.8.8.8/1.1.1.1
# used to run unconditionally and broke exactly those. Set this only to
# deliberately reproduce the old behaviour on a host with a broken resolv.conf.
#   e.g. DNS_OVERRIDE=8.8.8.8,1.1.1.1
DNS_OVERRIDE=

# ===========================================
# DEMO SEED (inert unless deliberately re-enabled)
# ===========================================
# Nothing seeds at boot in any environment anymore. This flag exists only as a
# safety interlock: a production-mode process that sets SEED_ON_BOOT=true WITHOUT
# also setting ALLOW_DEMO_SEED=true is refused at boot, because that combination
# means someone is following a stale runbook that expects demo data (and the demo
# fixtures delete the eleven collections they own before writing). For a throwaway
# database, apply fixtures on purpose with `npm run fixtures:apply`. Leave this
# false on any real deployment.
ALLOW_DEMO_SEED=false

# ===========================================
# ENV FILE LOCATION
# ===========================================
# Path to the .env this process loads, resolved before any module reads
# process.env. Unset defaults to server/.env. Its real purpose is hermetic test
# runs: point ENV_FILE at an empty file so a test harness never loads the
# developer's .env (which carries live SMTP_* and CLOUDINARY_* credentials, so
# loading it inside a test run emails Gmail and uploads to the CDN). Existing
# environment variables always win over file values.
#   ENV_FILE=/absolute/path/to/.env

# ===========================================
# OPERATIONAL TUNING (all optional; defaults shown)
# ===========================================
# The console-role idle sign-out window in minutes. Customer sessions are not
# swept by it. 0 disables the idle rule entirely; sub-1 values are accepted for
# tests but the boot line calls that out as a testing configuration.
SESSION_IDLE_MINUTES=60

# The "this is us" origins, beyond FRONTEND_URL, that image/logo fetch code
# treats as same-origin when checking manufacturer-supplied URLs (the SSRF hop
# check in routes/manufacturer.js). Set FRONTEND_URL only if none applies.
#   PUBLIC_URL=https://optikart.example
#   APP_URL=https://optikart.example
# PUBLIC_URL=
# APP_URL=

# Delivery dispatch economics. A partner is offered a collection when they are
# within this radius of the store; the longest store-to-buyer leg a partner may
# be given; and the rupee tolerance per which the weekly COD reconciliation
# flags a partner whose collected cash and completed legs disagree (a ₹5 coin
# is a ledger question, not a fraud alert; ₹200 is).
PARTNER_PICKUP_RADIUS_KM=4.5
MAX_DELIVERY_LEG_KM=23
PARTNER_RANK_COD_TOLERANCE_RUPEE=1

# Weekly partner ranking clock: minutes east of UTC defining "a week" for the
# leaderboard windows. Default 330 = IST (5:30).
PARTNER_RANK_TZ_OFFSET_MINUTES=330

# When a routed order's 12-minute offer window expires unanswered and no
# administrator has acted, score the candidates (distance, rating, sales, open
# orders) and assign the best; off by default, which leaves the order in the
# admin queue (the queue is a queue, not a graveyard; this flag only changes
# who pulls it out of it).
AI_ORDER_ASSIGNMENT=false

# One string for the Cloudinary SDK; preferred over the separate keys when set.
#   CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
# Folder/prefix every upload is stored under (default "optikart" when unset).
CLOUDINARY_FOLDER=optikart

# SMTP: implicit TLS on connect (port 465 style). The 587 STARTTLS default is
# already inferred; set this only to force secure for a nonstandard host.
SMTP_SECURE=false

# Verbose product-list query logging to stdout (LIST QUERY: ...). Troubleshoot-
# ing aid; noisy in production.
DEBUG_QUERIES=

# Content-Security-Policy mode for document responses (GET+HTML only):
#   enforce - the policy ships as `Content-Security-Policy` (production default)
#   report  - `…-Report-Only`: browsers still observe and still POST to the
#             sink (/api/security/csp-report), so a policy change can be
#             MEASURED again before the next enforce deploy
#   off     - no header; the policy never silently fails-open from an unset.
# Default is enforce because the policy this file ships was walked by a real
# browser against the real bundle (logins, console roles, PDP, cart, checkout)
# with zero violation reports, and that result is pinned by
# server/scripts/csp_mode_e2e.mjs. The report-mode remains exactly as capable
# as it was: switch CSP_MODE=report for a staging deploy after each policy
# change, read /api/admin/system/metrics `cspViolations`, flip back to enforce.
# (Dev servers on localhost carry the same policy; CRA websocket HMR connects
# to ws://localhost which the connect-src wss:/localhost:* arms cover.)
CSP_MODE=enforce

# -------------------------------------------------------------
# One-off operator commands (env switches consumed by the scripts, NOT by the
# server; listed here so a fresh operator can find them at all):
#   DANGEROUS_CONFIRM=yes  npm run deprovision:demo        removes demo accounts
#   DANGEROUS_CONFIRM=yes REMOVE_DEMO_CATALOGUE=yes \
#     npm run deprovision:demo                              also resets the demo
#       catalogue: products, brands, stock rows, coupons, help articles and
#       blog posts - by COLLECTION, so only ever the right answer on a database
#       that is nothing but demo data. See SYSTEM.md "Demo fixtures".
# -------------------------------------------------------------

# ===========================================
# SHARED LIMITER STORE (optional; single-replica installs need nothing here)
# ===========================================
# When the API runs ONE replica, the per-process limiters are exactly what
# the limits mean. The moment replicas multiply, so do the limits, silently:
# RedisStore makes every limiter in middleware/rateLimiter.js count the same
# key regardless of which pod served the request. There is no middle: if
# REDIS_URL is set and unreachable (or `redis` not installed) THE PROCESS
# REFUSES TO BOOT with the reason, instead of quietly serving per-pod counts
# that contradict this file's promises. The behaviour is pinned by
# server/scripts/redis_limiter_store_e2e.mjs.  (The `redis` optional package
# was installed for that suite; unset the flag if you do not want Redis.)
#   REDIS_URL=redis://127.0.0.1:6379
