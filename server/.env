# ===========================================
# SERVER CONFIGURATION
# ===========================================
PORT=5000

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# MongoDB connection string
# For local development with MongoDB installed:
MONGODB_URI=mongodb://localhost:27017/eyewear-platform

# For MongoDB Atlas (cloud database):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/eyewear-platform?retryWrites=true&w=majority

# ===========================================
# JWT AUTHENTICATION
# ===========================================
# Secret key for JWT token signing
# IMPORTANT: Use a strong random string in production
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=eyewear-platform-secret-key-2024

# ===========================================
# FRONTEND URL (CORS)
# ===========================================
# URL of your frontend application (used for CORS)
FRONTEND_URL=http://localhost:3000

# For production:
# FRONTEND_URL=https://yourdomain.com

# ===========================================
# ADMIN EMAIL
# ===========================================
# Admin email for notifications and system alerts
ADMIN_EMAIL=samedayopticians@gmail.com

# ===========================================
# EMAIL CONFIGURATION (SMTP)
# ===========================================
# Used for sending OTP emails, order confirmations, etc.
# For Gmail: You need to generate an App Password
# Go to: https://myaccount.google.com/apppasswords
# Enable 2FA first, then generate App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=samedayopticians@gmail.com
SMTP_PASS=your_gmail_app_password_here

# For other email providers:
# SendGrid:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your_sendgrid_api_key

# Mailgun:
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=your_mailgun_username
# SMTP_PASS=your_mailgun_password

# ===========================================
# RAZORPAY PAYMENT GATEWAY
# ===========================================
# Get these from: https://dashboard.razorpay.com/
# Go to Settings > API Keys > Generate Test/Live Keys
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# ===========================================
# SHIPROCKET SHIPPING API
# ===========================================
# Get these from: https://app.shiprocket.in/
# Login and go to Settings > API
SHIPROCKET_EMAIL=your_shiprocket_email@example.com
SHIPROCKET_PASSWORD=your_shiprocket_password_here
SHIPROCKET_API_KEY=your_shiprocket_api_key_here

# ===========================================
# CLOUDINARY (Image Storage)
# ===========================================
# Get these from: https://cloudinary.com/
# Used for product images, prescription uploads, etc.
# Go to Dashboard > Account Details > Cloudinary Settings
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# ===========================================
# NODE ENVIRONMENT
# ===========================================
NODE_ENV=development

# For production deployment:
# NODE_ENV=production

# ===========================================
# AI CHATBOT CONFIGURATION
# ===========================================
# OpenAI API for intelligent chatbot responses
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo

# Chatbot knowledge base settings
CHATBOT_ENABLED=true
CHATBOT_MAX_TOKENS=500
CHATBOT_TEMPERATURE=0.7

# ===========================================
# FACE DETECTION & ANALYSIS API
# ===========================================
# AWS Rekognition for face shape detection
# Get credentials from: https://aws.amazon.com/rekognition/
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1

# Alternative: Google Cloud Vision API
# Get from: https://cloud.google.com/vision
GOOGLE_VISION_API_KEY=your_google_vision_api_key_here

# Alternative: Azure Face API
# Get from: https://azure.microsoft.com/en-us/products/ai-services/face-api/
AZURE_FACE_API_KEY=your_azure_face_api_key_here
AZURE_FACE_ENDPOINT=https://your-region.api.cognitive.microsoft.com/

# Face detection service preference: 'aws', 'google', or 'azure'
FACE_DETECTION_SERVICE=aws

# ===========================================
# SPEECH RECOGNITION (Audio Search)
# ===========================================
# Google Cloud Speech-to-Text API
# Get from: https://cloud.google.com/speech-to-text
GOOGLE_SPEECH_API_KEY=your_google_speech_api_key_here

# Alternative: AWS Transcribe
# Uses same AWS credentials as above
AWS_TRANSCRIBE_ENABLED=true

# Speech recognition service preference: 'google' or 'aws'
SPEECH_RECOGNITION_SERVICE=google

# ===========================================
# ADDITIONAL API CONFIGURATIONS
# ===========================================
# Virtual Try-On AR Service (optional)
# Get from: https://www.banuba.com/ or https://deepar.co/
VIRTUAL_TRYON_API_KEY=your_virtual_tryon_api_key_here
VIRTUAL_TRYON_ENABLED=false

# Analytics & Monitoring (optional)
# Sentry for error tracking
SENTRY_DSN=your_sentry_dsn_here

# Google Analytics
GOOGLE_ANALYTICS_ID=your_ga_id_here
