{
  "printWidth": 120,
  "singleQuote": true,
  "semi": true,
  "tabWidth": 2,
  "arrowParens": "always",
  "trailingComma": "es5",
  "endOfLine": "lf",
  "overrides": [
    { "files": ["*.md"], "options": { "printWidth": 100, "proseWrap": "preserve" } },
    { "files": ["*.json"], "options": { "trailingComma": "none" } }
  ]
}
