# Dependencies
node_modules/
*/node_modules/

# Build output
client/build/

# Environment variables
.env
# The API env file holds live-looking AWS/Azure/OpenAI keys and the Atlas URI.
# It was committed before this rule existed, so it needs an explicit untrack:
#   git rm --cached server/.env
server/.env
.env.local
.env.production

# Logs
logs/
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# MongoDB memory server
/tmp/mongo-mem-*

# Test coverage
coverage/

# Temporary files
*.tmp
.tmp/

# Runtime file storage (uploaded banners, product images, prescriptions)
server/uploads/
!server/uploads/.gitkeep

# Local test/build artifacts
client/build/

# NOTE: server/.mongo.mjs (the harness's isolated-database launcher, spawned by
# scripts/verify.mjs) is AUTHORITATIVE and tracked. It used to live in this
# ignore list, which is why clean clones could not run `node scripts/verify.mjs`
# without an external MONGODB_URI: a gate file that only exists untracked on one
# laptop is not a gate.

# browser automation scratch output
.playwright-cli/

# verification harness output
.verify-logs/

# Dev-time leftovers from the pre-memoryStorage upload path (bulk test sheets).
# Nothing reads them; the app has not written here since uploads moved to
# services/storage.js. Untracked at the tip; history left alone pending the
# authorised purge decision.
uploads/
server/invoices-private/

# generated platform paperwork (tax PDFs) - runtime data, never committed
server/generated/
